# Can Psikoloji — statik yayın (cPanel / LiteSpeed / Apache)
# Eski WordPress adreslerinin SEO değerini yeni siteye 301 ile taşır.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) HTTPS ve www'siz tek adres (canonical: https://canpsikoloji.com/)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://canpsikoloji.com%{REQUEST_URI} [R=301,L]

# 2) Eski WordPress sayfaları -> yeni bölümler (hem /index.php/slug/ hem /slug/)
RewriteRule ^(?:index\.php/)?hakkimizda/?$ /#yaklasim [R=301,NE,L]
RewriteRule ^(?:index\.php/)?(?:hizmetlerimiz|bireysel-terapiler|cocuk-ve-ergen-terapileri|cift-ve-aile-terapileri|psikolojik-test-ve-degerlendirme)/?$ /#alanlar [R=301,NE,L]
RewriteRule ^(?:index\.php/)?(?:uzmanlarimiz-2|psikolojik-danisman-psikoterapist-nurcan-ilkan|psikolog-basak-canturk)/?$ /#uzmanlar [R=301,NE,L]
RewriteRule ^(?:index\.php/)?galeri/?$ /#merkez [R=301,NE,L]
RewriteRule ^(?:index\.php/)?bize-ulasin/?$ /#iletisim [R=301,NE,L]

# 3) Eski sitemap adresleri -> yeni sitemap
RewriteRule ^(?:index\.php/)?(?:sitemap_index|wp-sitemap|page-sitemap)\.xml$ /sitemap.xml [R=301,L]

# 4) /index.php ve /index.php/ -> ana sayfa
RewriteRule ^index\.php/?$ / [R=301,L]
</IfModule>

# Önbellek ve sıkıştırma
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
